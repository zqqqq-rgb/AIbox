FROM alpine:3.22 AS certificates

FROM ubuntu:24.04
# Ubuntu minimal has no CA bundle yet. Bootstrap HTTPS with the public roots
# shipped by an official distribution image; keep certificate verification on.
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get -o Acquire::Retries=3 update \
    && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
       build-essential cmake pkg-config ca-certificates \
       libjsoncpp-dev libsqlite3-dev libcpp-httplib-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["bash", "-lc", "cmake -S /workspace -B /tmp/aibox-build -DAIBOX_BUILD_TESTS=ON && cmake --build /tmp/aibox-build -j4 && ctest --test-dir /tmp/aibox-build --output-on-failure"]
